{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "src/specs/**/*.ts",
    "src/support/**/*.ts",
    "src/docs-screenshots/**/*.ts",
    "src/docs-videos/**/*.ts",
    "playwright.config.ts",
    "docs-screenshots.config.ts",
    "docs-videos.config.ts"
  ]
}
