{
  "name": "role-census",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/role-census",
  "projectType": "application",
  "tags": ["type:tool"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx ts-node --transpile-only tools/role-census/check-role-census.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "self-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/role-census/run-self-test.js",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
