{
  "name": "@ptah-extension/windows-job-native",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/windows-job-native/src",
  "tags": [
    "scope:shared",
    "type:util"
  ],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/backend/windows-job-native",
        "main": "libs/backend/windows-job-native/src/index.ts",
        "tsConfig": "libs/backend/windows-job-native/tsconfig.lib.json",
        "format": [
          "cjs"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/windows-job-native/tsconfig.lib.json"
      }
    },
    "test": {
      "cache": false
    }
  }
}
