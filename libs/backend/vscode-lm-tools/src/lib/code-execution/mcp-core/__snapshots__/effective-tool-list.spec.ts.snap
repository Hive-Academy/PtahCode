          "description": "Task folder names this task depends on",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "description": {
          "description": "One-line summary. Long-form context does NOT go here.",
          "type": "string",
        },
        "duplicates": {
          "description": "Task folder names this task duplicates",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "estimate": {
          "description": "Relative size, smallest first. It is a rough signal, not a duration, and nothing sums it.",
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL",
          ],
          "type": "string",
        },
        "executor": {
          "description": "Agent expected to execute it",
          "type": "string",
        },
        "labels": {
          "description": "Free-text labels. Matching is case- and whitespace-insensitive, so reuse an existing label rather than inventing a variant of it. Omit entirely when there are none.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "parent": {
          "description": "Folder name of the parent task. Parentage is ONE level deep: a parent that itself has a parent is reported as invalid rather than nested further.",
          "type": "string",
        },
        "relatesTo": {
          "description": "Loosely-related task folder names. Declare the relation on ONE side only — the other direction is derived, and writing both sides is how the two disagree later.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "title": {
          "description": "Short imperative title",
          "type": "string",
        },
        "type": {
          "description": "Task type",
          "enum": [
            "FEATURE",
            "BUGFIX",
            "REFACTORING",
            "DOCUMENTATION",
            "RESEARCH",
            "DEVOPS",
            "SAAS_INIT",
            "CREATIVE",
          ],
          "type": "string",
        },
        "worktreePath": {
          "description": "Registered worktree path; defaults to workspace.",
          "type": "string",
        },
      },
      "required": [
        "title",
        "type",
      ],
      "type": "object",
    },
    "name": "ptah_task_create",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Change a task's status and/or its metadata in one write. Give at least one field besides taskId. Rewrites only the frontmatter, and refuses the write with a retryable TASK_CONFLICT if the carrier changed on disk since it was read — so a concurrent edit is reported rather than silently discarded. On TASK_CONFLICT, re-read with ptah_task_get and retry. EVERY field is a FULL REPLACEMENT, never a merge: to add one label, read the task first and send the complete new array. An empty array or null REMOVES the field (dependsOn is the exception — [] clears it in place).",
    "inputSchema": {
      "properties": {
        "dependsOn": {
          "description": "Complete replacement dependency list. There is no "blocks" field: to record that A blocks B, add A to B's dependsOn.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "duplicates": {
          "description": "Complete replacement list of task folders this one duplicates. [] removes the field.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "estimate": {
          "description": "T-shirt size. null removes the field.",
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL",
            null,
          ],
          "type": [
            "string",
            "null",
          ],
        },
        "labels": {
          "description": "Complete replacement label set (max 12, each at most 32 characters, no newlines). [] removes all labels. Call ptah_task_list first and reuse an existing label rather than inventing a near-duplicate.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "parent": {
          "description": "Folder name of the parent task. Parentage is ONE level deep — a parent that itself has a parent is rejected. null removes it.",
          "type": [
            "string",
            "null",
          ],
        },
        "relatesTo": {
          "description": "Complete replacement list of loosely-related task folders. [] removes the field.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "status": {
          "description": "New status",
          "enum": [
            "backlog",
            "in_progress",
            "in_review",
            "blocked",
            "done",
            "cancelled",
          ],
          "type": "string",
        },
        "taskId": {
          "description": "Task folder name, e.g. TASK_2026_179",
          "type": "string",
        },
        "worktreePath": {
          "description": "Registered worktree path.",
          "type": "string",
        },
      },
      "required": [
        "taskId",
      ],
      "type": "object",
    },
    "name": "ptah_task_update",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Read one task: its metadata, its carrier body, and the documents present in its folder. Metadata includes labels, estimate, parent, duplicates and relatesTo. Returns TASK_NOT_FOUND when the folder has no carrier.",
    "inputSchema": {
      "properties": {
        "taskId": {
          "description": "Task folder name, e.g. TASK_2026_179",
          "type": "string",
        },
        "worktreePath": {
          "description": "Registered worktree path.",
          "type": "string",
        },
      },
      "required": [
        "taskId",
      ],
      "type": "object",
    },
    "name": "ptah_task_get",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "List tasks, optionally filtered by status and/or type, newest-created first. Paged: limit 25 (max 200); a page holds fewer rows when the response budget is reached. The result gives count (rows on this page), total (every match), and nextCursor when more rows follow — pass it back unchanged as cursor. If tasks at that position were renamed, added or removed, it is refused with INVALID_CURSOR: restart without cursor. Rows are summaries by default: no description or validation issues. For a full row call ptah_task_get, or pass fields:'full'. Summaries keep labels, estimate, parent and relations, so use this to reuse a label the workspace already has, and to find the newest ids rather than reading a generated registry, which can be stale.",
    "inputSchema": {
      "properties": {
        "cursor": {
          "description": "The nextCursor of the previous page, unchanged",
          "type": "string",
        },
        "fields": {
          "description": "'full' adds description and validation issues",
          "enum": [
            "summary",
            "full",
          ],
          "type": "string",
        },
        "limit": {
          "description": "Rows per page (default 25)",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "status": {
          "description": "Only include these statuses",
          "items": {
            "enum": [
              "backlog",
              "in_progress",
              "in_review",
              "blocked",
              "done",
              "cancelled",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "type": {
          "description": "Only include these types",
          "items": {
            "enum": [
              "FEATURE",
              "BUGFIX",
              "REFACTORING",
              "DOCUMENTATION",
              "RESEARCH",
              "DEVOPS",
              "SAAS_INIT",
              "CREATIVE",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "worktreePath": {
          "description": "Registered worktree path.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "ptah_task_list",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Health-check the whole task tree. Names SKIPPED folders with the typed reason each was skipped, plus included tasks carrying a validation warning — at most 50 of each, with excludedTotal and invalidTotal giving the full counts; healthy is judged on the full set. Run this when a task folder you expect is missing from the board.",
    "inputSchema": {
      "properties": {
        "worktreePath": {
          "description": "Registered worktree path.",
          "type": "string",
        },
      },
      "type": "object",
