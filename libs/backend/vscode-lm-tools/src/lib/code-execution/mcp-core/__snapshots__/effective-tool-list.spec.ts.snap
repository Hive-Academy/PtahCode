            },
            {
              "additionalProperties": false,
              "properties": {
                "agentId": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "agentId",
              ],
              "type": "object",
            },
          ],
        },
        "taskId": {
          "description": "Optional for kind deliverables; not allowed for any other kind.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "taskKind": {
          "description": "Optional for kind deliverables; not allowed for any other kind.",
          "enum": [
            "plan",
            "implement",
            "review",
            "research",
            "tests",
            "docs",
          ],
          "type": "string",
        },
        "verdict": {
          "description": "Required for kind review; not allowed for any other kind.",
