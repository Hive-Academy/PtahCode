        "path": {
          "description": "Must not be blank after trimming.",
          "maxLength": 1024,
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "description": "Trimmed by the host, then 1-120 characters.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "title",
      ],
      "type": "object",
    },
    "name": "ptah_artifact_publish",
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true,
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Spawn a headless agent to work on a task in the background. Supports system CLI agents (codex, copilot, cursor, antigravity, opencode, pi, grok, claude) and Ptah CLI agents, which are user-configured Anthropic-compatible providers. WHICH of either family exists on this machine is a runtime fact — call ptah_agent_list; do not assume a provider from any list you have read. The agent runs while you continue working. You do NOT need to poll: when the agent reaches a terminal status, a <agent-lane-completed> turn is pushed into this session carrying its status, exit code, duration and — when you declared "deliverables" — whether each declared file was actually written. A verdict of "no-deliverable" means the agent exited cleanly WITHOUT doing the work, so declare "deliverables" on every spawn whose output is a file. To block until lanes end, call ptah_agent_wait; never poll ptah_agent_status. HTTP calls wait at most 45 s, so repeat while lanes run. Use ptah_agent_status and ptah_agent_read as the fallback when no signal arrives (some adapters report nothing useful, and a signal is refused when this session is no longer live). For Ptah CLI agents, pass ptahCliId (from ptah_agent_list). Use modelTier to control capability level: "opus" for complex work, "sonnet" (default for Ptah CLI agents) for balanced work, "haiku" for fast work. Applies to Ptah CLI and cli "claude". To resume a previous CLI session, pass resume_session_id with the CLI session ID. Ideal for delegating: code reviews, test generation, documentation, and other independent subtasks.",
    "inputSchema": {
      "properties": {
        "accountSelection": {
          "additionalProperties": false,
          "description": "Optional account route, accepted only with cli "claude" and no ptahCliId. {"kind":"ambient"} uses the existing Claude login. {"kind":"omitted"}, the same as leaving this out, uses the lane account stored for the workspace when one is set, otherwise the existing Claude login. {"kind":"named","profileId":"<id>"} runs a fresh claude lane on that named Claude account; the spawn is refused when the account cannot be proved. A resume never takes a named account: it keeps the account stored with its session. Takes no path, environment, token or owner.",
          "properties": {
            "kind": {
              "enum": [
                "omitted",
                "ambient",
                "named",
              ],
              "type": "string",
            },
            "profileId": {
              "type": "string",
            },
          },
          "required": [
            "kind",
          ],
          "type": "object",
        },
        "cli": {
          "description": "Which system CLI agent to use. The enum above is the complete set of adapters this build ships; it is NOT the set installed here. Only CLIs actually installed on this machine will spawn — check ptah_agent_list first; naming an uninstalled CLI fails at spawn time. Omit to use the default (auto-detected or user-configured). Not needed when using ptahCliId. "claude" is a Claude Agent SDK session with Ptah tools over MCP, distinct from Ptah CLI agents.",
          "enum": [
            "codex",
            "copilot",
            "cursor",
            "antigravity",
            "opencode",
            "pi",
            "grok",
            "claude",
          ],
          "type": "string",
        },
        "deliverables": {
          "description": "The files this agent MUST write before it exits. A relative entry resolves against taskFolder when one is given, otherwise against workingDirectory. Two things use it: the agent is told to write exactly these paths, and the completion signal pushed back to you reports whether each one exists and is non-empty. Omit it and the signal can only say the process exited — an agent that exits 0 having written nothing then looks like a success. Declare it whenever the agent owes you a file.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "effort": {
          "description": "Reasoning effort for this lane: minimal, low, medium, high, xhigh or max. Wins over the per-CLI setting and the chat effort. A value the chosen CLI does not take is ignored. Omit to use the setting.",
          "type": "string",
        },
        "files": {
          "description": "List of files the agent should focus on",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "force": {
          "description": "Spawn even when ptah_agent_list shows this lane at its plan limit or in a cooldown. Use only when the limit is known to be wrong.",
          "type": "boolean",
        },
        "model": {
          "description": "Model override for the CLI agent, as a model id that CLI accepts. Valid ids are per-CLI and change between vendor releases — read them from that agent rather than from any list. Uses user-configured default if omitted.",
          "type": "string",
        },
        "modelTier": {
          "description": "Model capability tier for Ptah CLI agents. Controls which model tier the spawned agent uses. "opus" = most capable (complex architecture, deep analysis), "sonnet" = balanced (default, general coding tasks), "haiku" = fastest (simple tasks, quick lookups). The tier maps to a concrete model through the chosen provider's own tier mappings, so the same tier resolves differently per provider — you pick the tier, never the model id. Also applies to system cli "claude" as a native model alias when model is omitted. Other system CLIs ignore it.",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
          ],
          "type": "string",
        },
        "network": {
          "description": "Requested network mode. Unsupported choices are refused before spawn.",
          "enum": [
            "allow",
            "deny",
          ],
          "type": "string",
        },
        "permission": {
          "description": "Requested lane permission mode. Unsupported choices are refused before spawn.",
          "enum": [
            "plan",
            "ask",
            "auto-edit",
            "yolo",
          ],
          "type": "string",
        },
        "phase": {
          "description": "Validated phase dispatch from the host: version, kind, rendered text, definition, tool profile and optional resolved skills.",
          "type": "object",
        },
        "ptahCliId": {
          "description": "ID of a Ptah CLI agent to use (from ptah_agent_list results where cli="ptah-cli"). Ptah CLI agents are user-configured Anthropic-compatible providers. The set is per-user and per-machine, so ptah_agent_list is the only way to know which exist here. When set, cli parameter is ignored.",
          "type": "string",
        },
        "resume_session_id": {
          "description": "Resume a previous CLI agent session by its CLI-native session ID. The agent will continue from where the previous session left off. For cli "claude" this is the SDK session id; the resumed lane keeps the account stored with that session.",
          "type": "string",
        },
        "role": {
          "description": "Name of an agent role generated for this workspace. ptah_agent_list shows the valid names. The role definition is delivered to the agent, and the spawn result reports how it was delivered. Do not paste a role template into task; pass its name here instead.",
          "type": "string",
        },
        "routingSource": {
          "description": "What routed this lane: model, ranking, or pin.",
          "enum": [
            "model",
            "ranking",
            "pin",
          ],
          "type": "string",
        },
        "skills": {
          "description": "Host-resolved skills with name and path or text. CLI channels without a proven skill loader receive inline discipline and report skillDelivery unavailable.",
          "items": {
            "type": "object",
          },
          "type": "array",
        },
        "task": {
          "description": "Task description for the agent. Be specific about what to do, which files to focus on, and what output to produce.",
          "type": "string",
        },
        "taskFolder": {
          "description": "Task-spec folder for shared workspace (e.g., ".ptah/specs/TASK_2026_157"). Agent will write deliverables here.",
          "type": "string",
        },
        "taskKind": {
          "description": "Task kind this lane is routed for, recorded with its outcome.",
          "enum": [
            "plan",
            "implement",
            "review",
            "research",
            "tests",
            "docs",
          ],
          "type": "string",
        },
        "timeout": {
          "description": "Inactivity window in milliseconds: the agent is stopped after this long with no output (default: 3600000 = 1hr, no maximum, 0 disables it)",
          "type": "number",
        },
        "workingDirectory": {
          "description": "Working directory for the agent (must be within workspace). Defaults to workspace root.",
          "type": "string",
        },
      },
      "required": [
        "task",
      ],
      "type": "object",
    },
    "name": "ptah_agent_spawn",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Check the status of a specific agent or all agents. Returns agentId, status (running/completed/failed/timeout/stopped), cli, task, startedAt, duration, exitCode, and — when the adapter reports one — the CLI Session ID. That session id is what ptah_agent_spawn takes as resume_session_id, so its presence here is the signal to resume a timed-out agent rather than respawn it and lose its context.",
    "inputSchema": {
      "properties": {
        "agentId": {
          "description": "Agent ID to check. Omit to get status of ALL agents.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "ptah_agent_status",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Read the stdout/stderr output from an agent. For running agents, returns output captured so far. By default returns the last 200 lines of each stream, fewer when they would exceed the result size limit (the newest lines are kept; a line too long to fit is shown in part, and the full window is then saved to a file the result names). Each stream states the exact lines shown and how many were left out. Pass tail for a different window size, and offset to read forward starting at a given line.",
    "inputSchema": {
      "properties": {
        "agentId": {
          "description": "Agent ID to read output from",
          "type": "string",
        },
        "offset": {
          "description": "0-based first line of a forward window of tail lines (default 200) per stream",
          "type": "number",
        },
        "tail": {
          "description": "Lines to return per stream (default 200). Without offset these are the last lines",
          "type": "number",
        },
      },
      "required": [
        "agentId",
      ],
      "type": "object",
    },
    "name": "ptah_agent_read",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Send a message to a running agent. The delivery mechanism is chosen from that agent's own capability and REPORTED back as "mode": "steer" (injected into the turn in flight), "interrupt-resume" (the turn in flight was aborted and its partial work DISCARDED before the message was re-submitted), "queue-next-turn" (held and delivered as the next turn), or "unsupported" (nothing was delivered — "detail" says why). Always read "mode": it is not a plain success. Call ptah_agent_list first to see which mechanism each agent offers. Pass an idempotencyKey to make a repeat of the same call safe: it returns the first message, marked deduplicated. A lane may message only sibling lanes (same parent and workspace), at most 10/min and 32768 chars; its identity is its credential, never an argument.",
    "inputSchema": {
      "properties": {
        "agentId": {
          "description": "Agent ID to message",
          "type": "string",
        },
        "allowPartialTurnLoss": {
          "description": "Confirm loss of partial turn work when immediate delivery requires interrupt and resume.",
          "type": "boolean",
        },
        "delivery": {
          "description": "queue (default) waits for the next turn; now requests immediate delivery; steer requires live steering.",
          "enum": [
            "queue",
            "now",
            "steer",
          ],
          "type": "string",
        },
        "idempotencyKey": {
          "description": "1-128 characters of [A-Za-z0-9._:-], unique per target. Needs a session identity.",
          "type": "string",
        },
        "message": {
          "description": "Message text to deliver to the agent (max 102400 characters)",
          "type": "string",
        },
      },
      "required": [
        "agentId",
        "message",
      ],
      "type": "object",
    },
    "name": "ptah_agent_message",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Read the delivery status of an agent message: state, requestedAgentId and agentId (they differ after a resume), attemptCount, lastError, nextRetryAt, sender and ackState. "settled" means the turn ended, not that the agent acted on the message. An "outcome-unknown" message may already have run. ackState is the agent's own acknowledgment: "pending" (not yet), "read", "acted", "rejected", or "unavailable" (the agent cannot call Ptah tools). A lane sees only messages it sent or received.",
    "inputSchema": {
      "properties": {
        "agentId": {
          "description": "Agent ID",
          "type": "string",
        },
        "messageId": {
          "description": "Message ID",
          "type": "string",
        },
      },
      "required": [
        "agentId",
        "messageId",
      ],
      "type": "object",
    },
    "name": "ptah_agent_message_status",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Retry or cancel a message you sent with ptah_agent_message; you cannot act on messages others sent. Retry re-delivers a held, failed, expired or outcome-unknown message. A message that already reached the agent once needs confirmDuplicateRisk: true, because it may already have run. Cancel stops an undelivered message and deletes its text.",
    "inputSchema": {
      "properties": {
        "action": {
          "description": "retry or cancel",
          "enum": [
            "retry",
            "cancel",
          ],
          "type": "string",
        },
        "agentId": {
          "description": "Agent ID the message was sent to",
          "type": "string",
        },
        "confirmDuplicateRisk": {
          "description": "Confirm a retry that may deliver the message twice.",
          "type": "boolean",
        },
        "messageId": {
          "description": "Message ID from ptah_agent_message",
          "type": "string",
        },
      },
      "required": [
        "agentId",
        "messageId",
        "action",
      ],
      "type": "object",
    },
    "name": "ptah_agent_message_control",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Acknowledge a message you received as "[Ptah message <id> from ...]". state "read" says you saw it, "acted" that you did what it asked, "rejected" that you will not. Go forward only (read, then acted); rejected is final. Repeating the same state changes nothing. There is no "agentId" argument: you are identified by your connection.",
    "inputSchema": {
      "properties": {
        "messageId": {
          "description": "Message ID from the message header",
          "type": "string",
        },
        "note": {
          "description": "Optional short note, at most 500 characters.",
          "type": "string",
        },
        "state": {
          "description": "read, acted or rejected",
          "enum": [
            "read",
            "acted",
            "rejected",
          ],
          "type": "string",
        },
      },
      "required": [
        "messageId",
        "state",
      ],
      "type": "object",
    },
    "name": "ptah_agent_message_ack",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Report back to the session that spawned you — a blocker, a finding, or a question during the run. A clean success needs no report: the completion signal and deliverable file cover it. If you send a closing success report, set final: true so it can join the completion signal. The message appears in that session when delivered and on your own agent tile. You are identified automatically; there is no agent id to pass and you cannot report on behalf of another agent. A refused report returns "delivered": false with a reason. Rate-limited per agent; send considered updates. A final report may return pending: true with reason held-for-completion; do not resend it. A child session started by ptah_session_start can call it too; its report reaches the session that started it and ignores final.",
    "inputSchema": {
      "properties": {
        "final": {
          "description": "Closing success report, about to exit; held briefly for completion.",
          "type": "boolean",
        },
        "message": {
          "description": "The report body to deliver to the spawning session",
          "type": "string",
        },
        "summary": {
          "description": "Optional one-line summary (max 200 characters) shown on the agent tile",
          "type": "string",
        },
      },
      "required": [
        "message",
      ],
      "type": "object",
    },
    "name": "ptah_agent_report",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Stop a running agent. Sends SIGTERM, waits 5 seconds, then SIGKILL. If agent is already completed, returns its final status without error.",
    "inputSchema": {
      "properties": {
        "agentId": {
          "description": "Agent ID to stop",
          "type": "string",
        },
      },
      "required": [
        "agentId",
      ],
      "type": "object",
    },
    "name": "ptah_agent_stop",
  },
  {
    "_meta": {
      "anthropic/alwaysLoad": true,
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "List all available agents (CLI and Ptah CLI) that can be spawned. Returns agent type, installation status, and capabilities. Ptah CLI agents include ptahCliId needed for ptah_agent_spawn. AT LIMIT lanes refuse spawns; an unknown Limit state means the limit could not be read, not room.",
    "inputSchema": {
      "properties": {},
      "type": "object",
    },
    "name": "ptah_agent_list",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Start a child chat session on a new branch and worktree; attachToSessionId (same taskId and branch) shares one, kept on failure. phase and skills are optional. It opens in the user's tab and runs unattended: file edits and allowlisted Bash run without asking; other actions wait briefly in that tab, then are denied. Steer with ptah_session_send. The child reports with ptah_agent_report; completion is pushed here after each turn. A task starting with "/" runs as a slash command. Children cannot start sessions. Succession sets handed-off status with succeededBy. The user owns merge, PR and cleanup; branch and worktree remain. No permission, path or parent argument: you are the parent. Refusals include a code. Use a smaller model or lower effort for coordination, Git or CI; use a strong model for unknown causes, security or architecture. Omit both for defaults. On a timeout, call ptah_session_status first: a starting child on your branch is your start; do not start again. Every ptah_session_* result ends with any completion a child produced while this session was not live ("Held while this session was not live").",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "attachToSessionId": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "baseRef": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "branch": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "deliverables": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 20,
          "type": "array",
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
          ],
          "type": "string",
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string",
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "phase": {
          "additionalProperties": false,
          "properties": {
            "definition": {
              "additionalProperties": false,
              "properties": {
                "acceptanceStep": {
                  "items": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "array",
                },
                "deliverable": {
                  "items": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "array",
                },
                "discipline": {
                  "additionalProperties": false,
                  "properties": {
                    "escalationProtocol": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "method": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "outputContract": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "refusals": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "returnValue": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "reviewerStance": {
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "method",
                    "outputContract",
                    "returnValue",
                    "refusals",
                    "escalationProtocol",
                  ],
                  "type": "object",
                },
                "input": {
                  "items": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "array",
                },
                "kind": {
                  "enum": [
                    "plan",
                    "architecture",
                    "implement",
                    "review",
                    "document-review",
                    "research",
                    "tests",
                    "docs",
                    "visual-review",
                    "design",
                    "batch",
                    "completion",
                  ],
                  "type": "string",
                },
                "requiredCapabilities": {
                  "items": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "array",
                },
                "toolProfile": {
                  "additionalProperties": false,
                  "properties": {
                    "disallowedTools": {
                      "items": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "permission": {
                      "enum": [
                        "allow",
                        "deny",
                        "prompt",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "disallowedTools",
                    "permission",
                  ],
                  "type": "object",
                },
                "verdict": {
                  "items": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "array",
                },
                "version": {
                  "const": 1,
                  "type": "number",
                },
              },
              "required": [
                "version",
                "kind",
                "input",
                "deliverable",
                "verdict",
                "acceptanceStep",
                "requiredCapabilities",
                "toolProfile",
                "discipline",
              ],
              "type": "object",
            },
            "kind": {
              "enum": [
                "plan",
                "architecture",
                "implement",
                "review",
                "document-review",
                "research",
                "tests",
                "docs",
                "visual-review",
                "design",
                "batch",
                "completion",
              ],
              "type": "string",
            },
            "skills": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "text": {
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "text": {
              "minLength": 1,
              "type": "string",
            },
            "toolProfile": {
              "additionalProperties": false,
              "properties": {
                "disallowedTools": {
                  "items": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "array",
                },
                "permission": {
                  "enum": [
                    "allow",
                    "deny",
                    "prompt",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "disallowedTools",
                "permission",
              ],
              "type": "object",
            },
            "version": {
              "const": 1,
              "type": "number",
            },
          },
          "required": [
            "version",
            "kind",
            "text",
            "definition",
            "toolProfile",
          ],
          "type": "object",
        },
        "skills": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string",
              },
              "path": {
                "minLength": 1,
                "type": "string",
              },
              "text": {
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "name",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "task": {
          "maxLength": 102400,
          "minLength": 1,
          "type": "string",
        },
        "taskFolder": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "taskId": {
          "maxLength": 64,
          "pattern": "^TASK_\\d{4}_\\d{3,}(?:_[0-9a-f]{4})?$",
          "type": "string",
        },
      },
      "required": [
        "task",
        "branch",
      ],
      "type": "object",
    },
    "name": "ptah_session_start",
  },
  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "description": "Send a message to one of your child sessions: the primary way to steer it. mode "queue" (default) starts a turn now when it is idle, or holds the message until its current turn ends; "steer" interrupts the turn in flight and starts a new one with the message; "if-idle" delivers only when it is idle and is refused as busy otherwise. The result states the effect, or the refusal with its reason. Every ptah_session_* result ends with any completion a child produced while this session was not live ("Held while this session was not live").",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 102400,
          "minLength": 1,
          "type": "string",
        },
        "mode": {
          "enum": [
            "queue",
            "steer",
            "if-idle",
          ],
          "type": "string",
        },
        "sessionId": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "sessionId",
        "message",
      ],
      "type": "object",
    },
    "name": "ptah_session_send",
