  {
    "_meta": {
      "anthropic/maxResultSizeChars": 8000,
    },
    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": false,
    },
    "description": "Declare checked deliverables for a run or attach a review verdict. Use the Ptah run tag when available, otherwise the Agent result agentId. For reviews, supply reviewerRunId to pair the reviewer with the reviewed run; a review may be reported before that run finishes. A held report joins the run when its stop arrives; queued means the outcome store is temporarily unavailable.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "deliverables",
            "review",
          ],
          "type": "string",
        },
        "paths": {
          "description": "Deliverable files: absolute paths inside the workspace, or workspace-relative paths. At most 20. Required for kind deliverables; not allowed for any other kind.",
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 20,
          "type": "array",
        },
        "reviewerRunId": {
          "description": "Optional for kind review; not allowed for any other kind.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "routingSource": {
          "description": "Optional for kind deliverables; not allowed for any other kind.",
