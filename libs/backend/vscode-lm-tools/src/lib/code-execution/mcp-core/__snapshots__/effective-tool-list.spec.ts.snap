  {
    "_meta": {
      "anthropic/maxResultSizeChars": 64000,
    },
    "annotations": {
      "readOnlyHint": false,
    },
    "description": "Choose how to staff one engineering request. stage "pre-flight" takes "request" and returns task type and depth. stage "gate-0.1" also takes "taskType", "depth", "phases" and optional "pins", "preferenceSource" and "preferences", and returns one roster entry per phase. Each phase may include "shape" (mechanical, logic, contract, test, docs, review) and "weight" (estimated source tokens in its batch read and write sets, plus 10% framing). Each row has "model", "tier" and "effort". For subagents, "tier" is the model alias to pass. For ptah-cli and "claude" rows, pass "tier" as "modelTier"; for other CLI rows, pass "model" unless "lane-default", and "effort". Pins win. Invalid arguments are an error that names the field. The call updates rotation state. Results are capped at 64,000 characters and 25,600 tokens; a larger result is returned as a tool error. When routing is not registered in this host, the error is: routing is not available in this host; use the skill's rule tables.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "description": "Required when stage is gate-0.1.",
          "enum": [
            "Full",
            "Partial",
            "Minimal",
          ],
          "type": "string",
        },
        "phases": {
          "description": "Required when stage is gate-0.1.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string",
              },
              "kind": {
                "enum": [
                  "plan",
                  "architecture",
                  "implement",
                  "review",
                  "document-review",
                  "research",
                  "tests",
                  "docs",
                  "visual-review",
                  "design",
                  "batch",
                  "completion",
                ],
                "type": "string",
              },
              "requiredCapabilities": {
                "items": {
                  "enum": [
                    "browser",
                  ],
                  "type": "string",
                },
                "maxItems": 1,
                "type": "array",
              },
              "reviews": {
                "items": {
                  "maxLength": 200,
                  "type": "string",
                },
                "maxItems": 64,
                "type": "array",
              },
              "role": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string",
              },
              "shape": {
                "enum": [
                  "mechanical",
                  "logic",
                  "contract",
                  "test",
                  "docs",
                  "review",
                ],
                "type": "string",
              },
              "toolProfile": {
                "additionalProperties": false,
                "properties": {
                  "disallowedTools": {
                    "items": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 256,
                    "type": "array",
                  },
                },
                "required": [
                  "disallowedTools",
                ],
                "type": "object",
              },
              "weight": {
                "maximum": 200000,
                "minimum": 0,
                "type": "integer",
              },
            },
            "required": [
              "id",
              "kind",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "pins": {
          "description": "Required when stage is .",
          "items": {
            "additionalProperties": false,
            "properties": {
              "executor": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string",
              },
              "model": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string",
              },
              "phaseId": {
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "phaseId",
              "executor",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "type": "array",
        },
        "preferenceSource": {
          "description": "Required when stage is .",
          "maxLength": 200,
          "type": "string",
        },
        "preferences": {
          "additionalProperties": false,
          "description": "Required when stage is .",
          "properties": {
            "prefer": {
              "items": {
                "maxLength": 200,
                "type": "string",
              },
              "maxItems": 32,
              "type": "array",
            },
          },
          "required": [
            "prefer",
          ],
          "type": "object",
        },
        "request": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string",
        },
        "stage": {
          "enum": [
            "pre-flight",
            "gate-0.1",
          ],
          "type": "string",
        },
        "taskType": {
          "description": "Required when stage is gate-0.1.",
