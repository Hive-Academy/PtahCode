{
  "cli": "antigravity",
  "argv": [
    "--mode",
    "plan",
    "--sandbox",
    "--disable-slash-commands",
    "--output-format",
    "stream-json",
    "--print",
    "Reply with the word OK."
  ],
  "exitCode": 3,
  "jsonLines": 4,
  "usageEvents": [
    {
      "event": "result",
      "numericFields": {
        "result.usage.input_tokens": 0,
        "result.usage.output_tokens": 0,
        "result.usage.thinking_tokens": 0,
        "result.usage.cache_read_tokens": 0,
        "result.usage.total_tokens": 0
      }
    }
  ],
  "stderrPresent": true,
  "note": "Only numeric usage fields retained; all string payloads and stderr discarded."
}